# Copy to .env for Compose. Export variables separately for CLI (CLI does not load .env).
TYPESAFE_API_KEY=
QWEN_BASE_URL=http://127.0.0.1:8000
BERT_BASE_URL=http://127.0.0.1:8001
CLASSIC_BASE_URL=http://127.0.0.1:8002
# Use explicit tested tags/digests before a formal benchmark.
VLLM_IMAGE=vllm/vllm-openai:v0.9.2
QWEN_MODEL=Qwen/Qwen3-0.6B
QWEN_REVISION=main
QWEN_MAX_MODEL_LEN=4096
QWEN_GPU_MEMORY_UTILIZATION=0.90
QWEN_DTYPE=bfloat16
BERT_DEVICE=cpu
BERT_MODEL_PATH=./models/bert
CLASSIC_MODEL_PATH=./models/classic
